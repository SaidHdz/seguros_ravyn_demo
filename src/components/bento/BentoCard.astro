---
/**
 * Bento Grid Card with Visible Scroll-Triggered Reveal & Hover Physics.
 * 
 * Uses .reveal-on-scroll with perceptible staggered delays and noticeable
 * hover elevation (-translate-y-2.5) with arrow translation.
 */
interface Props {
  title: string;
  category: string;
  description: string;
  isHighlighted?: boolean;
  delayClass?: string;
}

const { title, category, description, isHighlighted = false, delayClass = '' } = Astro.props;
---

<div
  class={`reveal-on-scroll ${delayClass} group rounded-3xl p-6 sm:p-8 flex flex-col justify-between min-h-[190px] sm:min-h-[220px] select-none cursor-pointer ${
    isHighlighted
      ? 'bg-blue-600 text-white shadow-xl ring-1 ring-blue-500 hover:bg-blue-700'
      : 'bg-white text-slate-900 shadow-sm border border-slate-200/90 hover:border-slate-300 hover:shadow-lg'
  }`}
  style="transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.5s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.3s ease, border-color 0.3s ease;"
  onmouseenter="this.style.transform='translateY(-6px)'"
  onmouseleave="this.style.transform='translateY(0)'"
>
  <!-- Top Action Arrow & Category Tag -->
  <div class="flex items-center justify-between mb-4">
    <div class="overflow-hidden">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class={`transform group-hover:translate-x-1.5 group-hover:-translate-y-1.5 transition-transform duration-300 ease-out ${
          isHighlighted ? 'text-white' : 'text-slate-900'
        }`}
      >
        <line x1="7" y1="17" x2="17" y2="7"/>
        <polyline points="7 7 17 7 17 17"/>
      </svg>
    </div>

    <span
      class={`text-[11px] font-mono tracking-wider uppercase px-2.5 py-0.5 rounded-full ${
        isHighlighted
          ? 'bg-white/20 text-white'
          : 'bg-slate-100 text-slate-600 border border-slate-200/60'
      }`}
    >
      {category}
    </span>
  </div>

  <!-- Text Block -->
  <div>
    <h3 class={`text-lg font-bold tracking-tight mb-1.5 ${isHighlighted ? 'text-white' : 'text-slate-900'}`}>
      {title}
    </h3>
    <p class={`text-xs sm:text-sm leading-relaxed font-normal ${isHighlighted ? 'text-blue-100' : 'text-slate-600'}`}>
      {description}
    </p>
  </div>
</div>
