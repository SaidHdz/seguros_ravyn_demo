---
/**
 * Avatar group component matching the editorial reference.
 * 
 * Renders 4 overlapping client circles with real corporate photography
 * plus an action circle with a subtle downward arrow, zero AI badges or emojis.
 */
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;

const clients = [
  { name: "David M.", initials: "DM", bg: "bg-slate-700" },
  { name: "Sarah T.", initials: "ST", bg: "bg-blue-900" },
  { name: "Robert K.", initials: "RK", bg: "bg-slate-800" },
  { name: "Jessica L.", initials: "JL", bg: "bg-blue-800" },
];
---

<div class={`flex items-center gap-2 ${className}`}>
  <!-- Overlapping Avatars -->
  <div class="flex -space-x-2.5 overflow-hidden p-0.5">
    {clients.map((client) => (
      <div
        class={`inline-block h-8 w-8 rounded-full ring-2 ring-[#11141D] ${client.bg} flex items-center justify-center text-[10px] font-bold text-white shadow-sm`}
        title={client.name}
      >
        {client.initials}
      </div>
    ))}
  </div>

  <!-- Direction Arrow Circle from Reference -->
  <a
    href="#quote-form"
    class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 flex items-center justify-center text-white transition-colors"
    aria-label="Scroll to quote form"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="12" y1="5" x2="12" y2="19"/>
      <polyline points="19 12 12 19 5 12"/>
    </svg>
  </a>
</div>
