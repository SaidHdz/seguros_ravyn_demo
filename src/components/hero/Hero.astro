---
/**
 * Editorial Hero Section.
 * 
 * Re-engineered to match the benchmark reference:
 * - Real, authentic portrait of the agent in a grey tailored blazer on a seamless black background.
 * - Perceptible, fluid entrance animations on page load (heroLeft, heroCenter, heroRight).
 * - Left column typography, center photo presence, and right column credential cards.
 */
import AvatarGroup from './AvatarGroup.astro';
---

<section class="w-full bg-[#05070B] rounded-[32px] sm:rounded-[44px] text-white p-6 sm:p-10 lg:px-14 lg:pt-10 lg:pb-0 relative overflow-hidden shadow-2xl flex flex-col justify-between">
  
  <!-- Content Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end relative z-20 flex-1">
    
    <!-- Left Column: Typography & Outline Tags (Animates smoothly from left) -->
    <div class="lg:col-span-5 flex flex-col items-start justify-center z-20 pt-2 pb-8 lg:pb-10 animate-hero-left">
      <span class="inline-flex items-center px-4 py-2 rounded-full bg-blue-600 text-white font-extrabold text-xs sm:text-sm uppercase tracking-wider mb-6 shadow-md">
        2026 COVERAGE PLANS
      </span>

      <h1 class="text-4xl sm:text-5xl lg:text-[52px] font-extrabold text-white tracking-tight leading-[1.08]">
        Secure Your
        <br />
        Family's Future
        <br />
        Today
      </h1>

      <p class="text-sm sm:text-base text-slate-300 font-normal leading-relaxed mt-6 max-w-sm font-sans">
        Customized Life, Auto, Home, and Health insurance plans. Receive an independent quote in less than 5 minutes.
      </p>

      <!-- Clean Outline Pill Tags (from reference) -->
      <div class="flex flex-wrap gap-2 mt-8">
        <span class="px-3.5 py-1.5 rounded-full border border-white/20 text-white/90 text-xs font-medium backdrop-blur-sm">
          zero broker fees
        </span>
        <span class="px-3.5 py-1.5 rounded-full border border-white/20 text-white/90 text-xs font-medium backdrop-blur-sm">
          instant 2-min response
        </span>
        <span class="px-3.5 py-1.5 rounded-full border border-white/20 text-white/90 text-xs font-medium backdrop-blur-sm">
          texas licensed #294018
        </span>
      </div>
    </div>

    <!-- Center Column: Agent Photograph (Animates upward from base) -->
    <div class="hidden lg:flex lg:col-span-4 justify-center items-end relative z-10 self-end -mb-1 animate-hero-center">
      <div class="relative w-full max-w-[540px]">
        <!-- Seamless Studio Portrait: pure black background blends 100% with container -->
        <img
          src="/images/hero_agent.jpg"
          alt="Licensed Insurance Advisor"
          class="w-full h-auto object-cover object-top select-none pointer-events-none"
          loading="eager"
        />
        <!-- Bottom Edge Fade to guarantee seamless melting into container bottom -->
        <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-[#05070B] via-[#05070B]/60 to-transparent pointer-events-none"></div>
        <div class="absolute inset-y-0 left-0 w-20 bg-gradient-to-r from-[#05070B] to-transparent pointer-events-none"></div>
        <div class="absolute inset-y-0 right-0 w-20 bg-gradient-to-l from-[#05070B] to-transparent pointer-events-none"></div>
      </div>
    </div>

    <!-- Right Column: Floating White Info Cards & Capsule CTA (Animates from right) -->
    <div class="lg:col-span-3 flex flex-col items-start lg:items-end justify-center space-y-4 z-20 pb-8 lg:pb-10 animate-hero-right">
      
      <!-- Card 1: Official Agency Credentials -->
      <div class="bg-white rounded-2xl p-4 sm:p-5 text-slate-900 shadow-xl w-full max-w-[260px] transform hover:-translate-y-1.5 transition-transform duration-300">
        <div class="flex items-center gap-2 text-xs font-bold text-slate-900 mb-1">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="m9 12 2 2 4-4"/>
          </svg>
          licensed agency:
        </div>
        <div class="text-xs text-slate-600 font-mono">
          texas dept. of insurance
        </div>
      </div>

      <!-- Card 2: Consultation Format -->
      <div class="bg-white rounded-2xl p-4 sm:p-5 text-slate-900 shadow-xl w-full max-w-[260px] transform hover:-translate-y-1.5 transition-transform duration-300">
        <div class="flex items-center gap-2 text-xs font-bold text-slate-900 mb-1">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="18" x="3" y="3" rx="2"/>
            <path d="m9 12 2 2 4-4"/>
          </svg>
          direct format:
        </div>
        <div class="text-xs text-slate-600 font-mono">
          quotes &bull; live agent dispatch
        </div>
      </div>

      <!-- Verified Social Proof Cluster -->
      <div class="pt-2 w-full max-w-[260px] flex items-center justify-between">
        <AvatarGroup />
        <span class="text-xs font-mono text-slate-400">240+ verified</span>
      </div>

      <!-- Capsule CTA Button -->
      <div class="pt-2 w-full max-w-[260px]">
        <a
          href="#calculator"
          class="w-full inline-flex items-center justify-center px-8 py-4 rounded-full bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white text-xs font-bold uppercase tracking-wider shadow-lg shadow-blue-600/30 transition-all transform hover:-translate-y-1 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-[#05070B]"
        >
          Get My Free Quote
        </a>
      </div>

    </div>

  </div>
</section>
