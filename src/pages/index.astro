---
/**
 * Ravyn Seguros Demo - Editorial Landing Page ($800+ Agency Tier).
 * 
 * Styled strictly to the European high-end editorial benchmark (Behance reference).
 * Features seamless black hero photography, rich insurance products, interactive
 * real-time savings calculator, and photorealistic tablet quotation review.
 */
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/common/Navbar.astro';
import Hero from '../components/hero/Hero.astro';
import BentoGrid from '../components/bento/BentoGrid.astro';
import SavingsCalculator from '../components/calculator/SavingsCalculator';
import LeadMachine from '../components/leads/LeadMachine.astro';
import Footer from '../components/common/Footer.astro';
